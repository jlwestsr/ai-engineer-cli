# OpenRouter (recommended for this project)
OPENROUTER_API_KEY=
AIE_BASE_URL=https://openrouter.ai/api/v1
AIE_MODEL=deepseek/deepseek-v4-pro

# Or plain OpenAI-compatible
# AIE_API_KEY=
# AIE_BASE_URL=https://api.openai.com/v1
# AIE_MODEL=gpt-4o-mini

AIE_MAX_STEPS=16
AIE_MAX_TOOL_CALLS=48
AIE_MAX_TOOLS_PER_TURN=6
